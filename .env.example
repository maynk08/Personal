# Backend API, called only from the portfolio server (never from the browser).
BACKEND_URL=http://localhost:4000

# The site's public address, used for canonical links, the sitemap and share previews.
SITE_URL=http://localhost:3000

# Optional: the public address of uploaded files when they are served from a CDN instead of S3
# (the same value as the backend's MEDIA_PUBLIC_BASE_URL). Needed for both the build and the server.
MEDIA_PUBLIC_BASE_URL=
